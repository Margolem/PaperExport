<Window x:Class="PaperExport.Viewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PaperExport Viewer" Width="1300" Height="800" MinWidth="900" MinHeight="600"
        Background="#F5F5F5" AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop">
  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Header="_Open..." Click="Open_Click" InputGestureText="Ctrl+O"/>
        <Separator/>
        <MenuItem Header="E_xit" Click="Exit_Click"/>
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem Header="_Reset view" Click="Reset_Click"/>
        <MenuItem Header="Show _grid" IsCheckable="True" IsChecked="True" Click="Grid_Click"/>
        <MenuItem Header="Show _hitbox" IsCheckable="True" Click="Hitbox_Click"/>
        <MenuItem Header="Show _pivots" IsCheckable="True" Click="Pivots_Click"/>
        <MenuItem Header="_White background" IsCheckable="True" Click="Background_Click"/>
      </MenuItem>
    </Menu>
    <ToolBarTray DockPanel.Dock="Top">
      <ToolBar>
        <Button Click="Open_Click" Padding="10,3">Open...</Button>
        <Button Click="Reset_Click" Padding="10,3">Reset view</Button>
        <Separator/>
        <CheckBox x:Name="GridCheck" IsChecked="True" Checked="Grid_Checked" Unchecked="Grid_Checked" Margin="5,0">Grid</CheckBox>
        <CheckBox x:Name="HitboxCheck" Checked="Hitbox_Checked" Unchecked="Hitbox_Checked" Margin="5,0">Hitbox</CheckBox>
        <CheckBox x:Name="PivotsCheck" Checked="Pivots_Checked" Unchecked="Pivots_Checked" Margin="5,0">Pivots</CheckBox>
        <CheckBox x:Name="WhiteCheck" Checked="Background_Checked" Unchecked="Background_Checked" Margin="5,0">White background</CheckBox>
      </ToolBar>
    </ToolBarTray>
    <StatusBar DockPanel.Dock="Bottom">
      <StatusBarItem><TextBlock x:Name="StatusText" Text="Open a .paperexport file"/></StatusBarItem>
    </StatusBar>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="235"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="260"/>
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="White" BorderBrush="#D0D0D0" BorderThickness="0,0,1,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="12">
            <TextBlock Text="ENTITY" FontWeight="SemiBold" Foreground="#555" FontSize="11"/>
            <TextBlock x:Name="EntityName" Text="No file open" FontWeight="SemiBold" FontSize="18" Margin="0,10,0,2" TextWrapping="Wrap"/>
            <TextBlock x:Name="EntityId" Foreground="#666" FontSize="11" TextWrapping="Wrap"/>
            <TextBlock x:Name="EntityStats" Margin="0,12,0,6" FontSize="12" TextWrapping="Wrap"/>
            <Separator Margin="0,10"/>
            <TextBlock Text="Hierarchy" FontWeight="SemiBold" Margin="0,0,0,7"/>
            <TreeView x:Name="HierarchyTree" BorderThickness="0" Background="Transparent" MinHeight="155"/>
            <Separator Margin="0,10"/>
            <TextBlock Text="Textures" FontWeight="SemiBold" Margin="0,0,0,7"/>
            <WrapPanel x:Name="TexturePanel"/>
          </StackPanel>
        </ScrollViewer>
      </Border>
      <Grid x:Name="ViewportHost" Grid.Column="1" Background="#F8F8F8"
            MouseDown="Viewport_MouseDown" MouseMove="Viewport_MouseMove"
            MouseUp="Viewport_MouseUp" MouseWheel="Viewport_MouseWheel">
        <Viewport3D x:Name="SceneViewport" ClipToBounds="True">
          <Viewport3D.Camera>
            <PerspectiveCamera x:Name="SceneCamera" FieldOfView="45" NearPlaneDistance="0.01" FarPlaneDistance="1000"/>
          </Viewport3D.Camera>
        </Viewport3D>
        <StackPanel x:Name="EmptyMessage" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
          <TextBlock Text="No file open" FontSize="20" TextAlignment="Center"/>
          <TextBlock Text="Drop a .paperexport file here or click Open." Foreground="#666" Margin="0,5,0,0"/>
        </StackPanel>
        <TextBlock Text="Drag to rotate · Scroll to zoom · Right drag to pan"
                   HorizontalAlignment="Left" VerticalAlignment="Bottom"
                   Margin="8" Padding="4" Foreground="#666" Background="#EEFFFFFF" FontSize="11"
                   IsHitTestVisible="False"/>
      </Grid>
      <Border Grid.Column="2" Background="White" BorderBrush="#D0D0D0" BorderThickness="1,0,0,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="12">
            <TextBlock Text="Animations" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <ListBox x:Name="AnimationList" Height="142" SelectionChanged="Animation_SelectionChanged"/>
            <Border BorderBrush="#DDD" BorderThickness="1" Background="#FAFAFA" Padding="8" Margin="0,10,0,0">
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <Button x:Name="PlayButton" Click="Play_Click" Width="34">Pause</Button>
                  <CheckBox x:Name="LoopCheck" IsChecked="True" Margin="10,4,5,0">Loop</CheckBox>
                  <TextBlock Text="Speed" Margin="8,4,4,0"/>
                  <ComboBox x:Name="SpeedBox" SelectedIndex="2" Width="60">
                    <ComboBoxItem Content="0.25×" Tag="0.25"/>
                    <ComboBoxItem Content="0.5×" Tag="0.5"/>
                    <ComboBoxItem Content="1×" Tag="1"/>
                    <ComboBoxItem Content="2×" Tag="2"/>
                  </ComboBox>
                </StackPanel>
                <Slider x:Name="Timeline" Minimum="0" Maximum="1" Margin="0,8,0,0"
                        ValueChanged="Timeline_ValueChanged"/>
                <TextBlock x:Name="TimeText" Text="0.00 / 0.00 s" HorizontalAlignment="Right" FontSize="11" Foreground="#666"/>
              </StackPanel>
            </Border>
            <Separator Margin="0,14"/>
            <TextBlock Text="Validation" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <TextBlock x:Name="ValidationText" Text="Open a package to validate it." TextWrapping="Wrap" FontSize="12" LineHeight="19"/>
            <Separator Margin="0,14"/>
            <TextBlock Text="Sounds" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <TextBlock x:Name="SoundsText" Text="None" TextWrapping="Wrap" FontSize="12"/>
            <Separator Margin="0,14"/>
            <TextBlock Text="Package files" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <ListBox x:Name="PackageFiles" Height="140" FontFamily="Consolas" FontSize="11" SelectionChanged="PackageFile_SelectionChanged"/>
            <TextBox x:Name="FilePreview" Height="190" Margin="0,8,0,0" FontFamily="Consolas" FontSize="10"
                     IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto" Background="#FAFAFA"/>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </DockPanel>
</Window>
